rules_version = '2';
// Reglas de seguridad de Game Over FC
//  - Cada jugador solo puede ser elegido por UN móvil (no se puede "robar" un usuario).
//  - Cada usuario solo puede cambiar SU voto y solo antes del cierre.
//  - Solo los administradores (players/{id}.role == "admin") pueden modificar todo lo demás.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasUser() { return signedIn() && exists(userPath()); }
    function myPlayer() { return get(userPath()).data.playerId; }
    function isAdmin() {
      return hasUser() && get(/databases/$(database)/documents/players/$(myPlayer())).data.role == 'admin';
    }
    // Voto propio dentro del plazo
    function onlyMyVote() {
      let before = resource.data.get('votes', {});
      let after = request.resource.data.get('votes', {});
      return hasUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && after.diff(before).affectedKeys().hasOnly([myPlayer()])
        && after[myPlayer()] in ['si', 'no']
        && resource.data.get('pollDeadline', null) != null
        && request.time < resource.data.pollDeadline;
    }

    match /players/{pid} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.get('uid', null) == null
        && !exists(userPath())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath()).data.playerId == pid
      );
    }

    match /users/{uid} {
      // Solo el propio usuario puede leer su documento (contiene sus códigos de valoración anónima)
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && getAfter(/databases/$(database)/documents/players/$(request.resource.data.playerId)).data.uid == uid;
      // Solo se pueden AÑADIR códigos de valoración (nunca cambiarlos ni borrarlos: una valoración por partido)
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingKeys'])
        && request.resource.data.ratingKeys is map
        && request.resource.data.ratingKeys.diff(resource.data.get('ratingKeys', {})).changedKeys().size() == 0
        && request.resource.data.ratingKeys.diff(resource.data.get('ratingKeys', {})).removedKeys().size() == 0;
      allow delete: if isAdmin();
    }

    match /tokens/{uid} {
      allow create, update: if hasUser() && request.auth.uid == uid && request.resource.data.playerId == myPlayer();
      allow read: if false;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /matches/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyMyVote();
    }

    // Valoraciones ANÓNIMAS: el documento tiene un código aleatorio; solo el usuario sabe cuál es el suyo
    function myRatingKeys() { return get(userPath()).data.get('ratingKeys', {}); }
    function validRating(mid) {
      // solo pueden valorar los que fueron al partido (votaron "Voy" o el admin los marcó como asistentes)
      return get(/databases/$(database)/documents/matches/$(mid)).data.get('votes', {}).get(myPlayer(), '') == 'si'
        && request.resource.data.keys().hasOnly(['scores', 'comments', 'updatedAt'])
        && request.resource.data.scores is map && request.resource.data.comments is map
        && request.resource.data.scores.size() <= 40 && request.resource.data.comments.size() <= 40
        && !(myPlayer() in request.resource.data.scores) && !(myPlayer() in request.resource.data.comments);
    }
    match /matches/{mid}/ratings/{key} {
      allow read: if signedIn();
      allow create: if hasUser() && validRating(mid)
        && !(mid in myRatingKeys())
        && getAfter(userPath()).data.ratingKeys[mid] == key;
      allow update: if hasUser() && validRating(mid) && myRatingKeys().get(mid, '') == key;
      allow delete: if isAdmin();
    }
    // Fantasy: cada jugador guarda SU predicción hasta que empieza el partido
    // Modo del Fantasy de cada partido (lo decide el admin): auto | open | closed | off
    function predOpen(mid) {
      let m = get(/databases/$(database)/documents/matches/$(mid)).data;
      let f = m.get('fantasy', {});
      let st = f.get('status', 'auto');
      return (st == 'open' && (f.get('closesAt', null) == null || request.time < f.closesAt))
        || (st == 'auto' && m.get('golesGO', null) == null && (
          m.get('date', null) == null
          || (m.get('timeKnown', false) == true && request.time < m.date)
          || (m.get('timeKnown', false) != true && request.time < m.date + duration.value(1, 'd'))));
    }
    match /matches/{mid}/predictions/{pid} {
      allow read: if signedIn();
      allow create, update: if hasUser() && pid == myPlayer() && predOpen(mid)
        && request.resource.data.keys().hasOnly(['gk', 'starters', 'pos', 'scorers', 'updatedAt'])
        && request.resource.data.gk is string
        && request.resource.data.starters is list && request.resource.data.starters.size() <= 4
        && request.resource.data.scorers is list && request.resource.data.scorers.size() <= 12
        && request.resource.data.pos is map && request.resource.data.pos.size() <= 4;
      allow delete: if isAdmin();
    }
    match /{path=**}/predictions/{pid} {
      allow read: if signedIn();
    }
    match /{path=**}/ratings/{rater} {
      allow read: if signedIn();
    }

    match /trainings/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || onlyMyVote();
    }

    // Fotos: las sube el fotógrafo (posición "Fotógrafo") o un admin
    function isPhotographer() {
      return hasUser() && (get(/databases/$(database)/documents/players/$(myPlayer())).data.get('position', '') == 'Fotógrafo' || isAdmin());
    }
    match /photos/{photoId} {
      allow read: if signedIn();
      allow create, update, delete: if isPhotographer();
      match /chunks/{n} {
        allow read: if signedIn();
        allow create, update, delete: if isPhotographer();
      }
    }
    match /albums/{mid} {
      allow read: if signedIn();
      allow create, update, delete: if isPhotographer();
    }

    // Multas: todos las ven, solo el admin las pone/cambia
    match /fines/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
